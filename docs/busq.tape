Output docs/busq.gif

Set Shell "zsh"
Set FontFamily "JetBrains Mono"
Set FontSize 18
Set Width 900
Set Height 430
Set Theme "Builtin Dark"
Set Padding 24
Set WindowBar Rings
Set TypingSpeed 15ms
Env PATH "target/debug:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

Type "busq --icons on -i"
Sleep 500ms
Enter
Sleep 3s
Type "q"
Sleep 500ms
